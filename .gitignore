# Dependencies
node_modules/

# Build output — regenerate with `npm run build`
dist/

# Environment — never commit real values. Copy .env.example to .env instead.
.env
.env.local
.env.*.local

# Editor / OS noise
.DS_Store
*.log
.vscode/
.idea/
__pycache__/

# HeyLloyd editor metadata (not needed outside the HeyLloyd sandbox)
.heylloyd/

# Originals uploaded to the editor. The versions the site actually serves
# live in client/public/ with clean filenames — these are duplicates.
attached_assets/

# Netlify migration: generated by scripts/netlify-build.py, not committed.
client/public/download/*.zip
.netlify/
